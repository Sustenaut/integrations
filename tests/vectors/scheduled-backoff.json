{
  "description": "A scheduled call (S) is tried again after 1 s and 2 s, past no answer",
  "plugin": "github.edit-pr",
  "operation": "check",
  "request": {
    "method": "GET",
    "url": "https://api.example/x"
  },
  "responses": {
    "GET https://api.example/x": [
      {
        "status": 503,
        "json": {}
      },
      {
        "error": "no answer"
      },
      {
        "status": 200,
        "json": {
          "a": 1
        }
      }
    ]
  },
  "expect": {
    "status": 200,
    "raises": null,
    "sent": 3,
    "sleeps": [
      1,
      2
    ],
    "record": {
      "status": 200,
      "outcome": "ok",
      "retries": 2,
      "bytes_in": 8
    }
  }
}
