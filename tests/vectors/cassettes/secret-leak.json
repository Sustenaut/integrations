{
  "description": "A secret the recorder saw that would still be written, here echoed in a body, stops the save",
  "scenario": "vectors: secret leak",
  "record": [
    {
      "status": 200,
      "body": {
        "json": {
          "echo": "Bearer jwt-secret-abcdef"
        }
      }
    }
  ],
  "steps": [
    {
      "call": {
        "plugin": "github.app-token",
        "operation": "mint-in-app",
        "method": "GET",
        "url": "https://api.github.com/app",
        "headers": {
          "Authorization": "Bearer jwt-secret-abcdef"
        }
      }
    },
    {
      "save": true
    }
  ],
  "expect": {
    "results": [
      {
        "status": 200,
        "headers": {},
        "json": {
          "echo": "Bearer jwt-secret-abcdef"
        }
      },
      {
        "raises": "SecretInRecording",
        "mentions": [
          "a secret seen at calls.0.request.headers.Authorization would be written in calls.0.response",
          "not saved"
        ]
      }
    ]
  }
}
