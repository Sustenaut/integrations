{
  "description": "A 429's Retry-After is waited for up to the class's timeout (S: 30 s)",
  "plugin": "github.edit-pr",
  "operation": "check",
  "request": {
    "method": "GET",
    "url": "https://api.example/x"
  },
  "responses": {
    "GET https://api.example/x": [
      {
        "status": 429,
        "json": {},
        "headers": {
          "Retry-After": "120"
        }
      },
      {
        "status": 200,
        "json": {}
      }
    ]
  },
  "expect": {
    "status": 200,
    "raises": null,
    "sent": 2,
    "sleeps": [
      30
    ],
    "record": {
      "outcome": "ok",
      "retries": 1
    }
  }
}
