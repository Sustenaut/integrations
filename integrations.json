{
  "uses": [
    {
      "plugin": "cloudflare.dns",
      "paths": [
        "src/integrations/clients/cloudflare_dns.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml",
        "src/integrations/clients/github_app_token.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.edit-pr",
      "paths": [
        "src/integrations/clients/github_edit_pr.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.ghcr",
      "paths": [
        ".github/workflows/deploy.yml",
        "k8s/app.yaml",
        "k8s/ingest.yaml",
        "k8s/kustomization.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.repo-ops",
      "paths": [
        ".github/workflows/wheel.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.bigquery",
      "paths": [
        "src/integrations/ingest/bigquery.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.cloud",
      "paths": [
        "src/integrations/ingest/google_token.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "letsencrypt.certs",
      "paths": [
        "k8s/ingress.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "linear.sync",
      "paths": [
        "src/integrations/clients/linear.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "slack.channel-heal",
      "paths": [
        "src/integrations/clients/slack.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "slack.post",
      "paths": [
        "src/integrations/cli.py",
        "src/integrations/clients/slack.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/pr.yml",
        ".github/workflows/main.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "storage.api",
      "paths": [
        "src/integrations/clients/storage.py",
        "src/integrations/storage_sink.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "tailscale.tailnet",
      "paths": [
        ".github/workflows/deploy.yml"
      ],
      "mode": "required"
    }
  ],
  "exclude": [
    {
      "path": "src/integrations/plugins/**",
      "reason": "the signatures themselves"
    },
    {
      "path": "src/integrations/not-providers.json",
      "reason": "the names the scan skips"
    },
    {
      "path": "tests/**",
      "reason": "scenarios about the signatures"
    },
    {
      "path": "corpus/**",
      "reason": "release records: changelog prose and the signed publets made from it"
    }
  ],
  "other_secrets": [
    {
      "name": "SUSTENAUT_DEPLOY_SSH_KEY",
      "reason": "An SSH key to our own server"
    }
  ],
  "own_hosts": [
    "sustenaut.eu"
  ]
}
