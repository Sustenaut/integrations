{
  "id": "cloudflare.dns",
  "provider": "Cloudflare",
  "use": "DNS and DNSSEC multi-signer",
  "operations": [
    {
      "name": "reconcile",
      "class": "E",
      "route": "routed"
    },
    {
      "name": "check",
      "class": "S",
      "route": "routed"
    }
  ],
  "setup": [
    "Create a DNS-scoped API token",
    "Store it in Bitwarden"
  ],
  "detect": {
    "hosts": [
      "api.cloudflare.com"
    ],
    "env": [
      "CLOUDFLARE_API_TOKEN"
    ]
  },
  "settings": {
    "type": "object",
    "required": [
      "token"
    ],
    "additionalProperties": false,
    "properties": {
      "token": {
        "type": "string",
        "description": "The DNS-scoped API token, from the project's Bitwarden project"
      }
    }
  }
}
