{
  "id": "terraform.hetzner",
  "provider": "Hetzner",
  "use": "Cloud servers and firewalls, through Terraform",
  "operations": [
    {
      "name": "provision",
      "class": "M",
      "route": "none"
    },
    {
      "name": "apply",
      "class": "E",
      "route": "reported"
    }
  ],
  "setup": [
    "Create a token for the provider and store it in the project's Bitwarden project"
  ],
  "detect": {
    "terraform_providers": [
      "hetznercloud/hcloud"
    ],
    "env": [
      "HCLOUD_TOKEN"
    ]
  }
}
