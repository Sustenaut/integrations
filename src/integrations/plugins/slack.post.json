{
  "id": "slack.post",
  "provider": "Slack",
  "use": "Bot posts and direct messages",
  "operations": [
    {
      "name": "post",
      "class": "E",
      "route": "routed"
    },
    {
      "name": "check",
      "class": "S",
      "route": "routed"
    }
  ],
  "setup": [
    "Create the Slack app",
    "Invite the bot to its channels",
    "Store the bot token in Bitwarden"
  ],
  "detect": {
    "hosts": [
      "slack.com"
    ],
    "env": [
      "[A-Z_]*SLACK[A-Z_]*(?:TOKEN|USER_ID)"
    ],
    "patterns": [
      "chat\\.postMessage",
      "\\bintegrations\\.clients\\.slack\\b",
      "\\bintegrations slack post\\b"
    ]
  },
  "settings": {
    "type": "object",
    "required": [
      "token"
    ],
    "additionalProperties": false,
    "properties": {
      "token": {
        "type": "string",
        "description": "The bot's token, from the project's Bitwarden project"
      }
    }
  }
}
