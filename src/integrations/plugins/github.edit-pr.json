{
  "id": "github.edit-pr",
  "provider": "GitHub",
  "use": "Open a pull request from an edit made in a web editor",
  "operations": [
    {
      "name": "open-pr",
      "class": "H",
      "route": "routed"
    },
    {
      "name": "check",
      "class": "S",
      "route": "routed"
    }
  ],
  "setup": [
    "Install a GitHub App with contents and pull-request write on the target repository"
  ],
  "detect": {
    "hosts": [
      "api.github.com"
    ],
    "commands": [
      "gh"
    ],
    "env": [
      "GH_TOKEN"
    ],
    "actions": [
      "peter-evans/create-pull-request"
    ],
    "patterns": [
      "\\bintegrations\\.clients\\.github_edit_pr\\b"
    ]
  },
  "settings": {
    "type": "object",
    "required": [
      "repo"
    ],
    "additionalProperties": false,
    "properties": {
      "repo": {
        "type": "string",
        "description": "owner/name of the repository edits go to"
      },
      "base": {
        "type": "string",
        "default": "main"
      }
    }
  }
}
