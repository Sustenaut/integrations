{
  "id": "bitwarden.secrets",
  "provider": "Bitwarden",
  "use": "Secrets Manager through bws and ./with-secrets",
  "operations": [
    {
      "name": "setup",
      "class": "M",
      "route": "none"
    },
    {
      "name": "read",
      "class": "E",
      "route": "reported"
    }
  ],
  "setup": [
    "Create the Bitwarden project",
    "Create a read-only machine account token",
    "Put the token in the repository's .env"
  ],
  "detect": {
    "commands": [
      "bws"
    ],
    "env": [
      "BWS_ACCESS_TOKEN"
    ],
    "files": [
      "with-secrets.json"
    ]
  }
}
