{
  "id": "github.app-token",
  "provider": "GitHub",
  "use": "GitHub App installation tokens for nightly, release and reader jobs",
  "operations": [
    {
      "name": "mint",
      "class": "E",
      "route": "reported"
    },
    {
      "name": "mint-in-app",
      "class": "H",
      "route": "routed"
    }
  ],
  "setup": [
    "Create the GitHub App",
    "Install it on the owner",
    "Send its id and key to the repository"
  ],
  "detect": {
    "actions": [
      "actions/create-github-app-token"
    ],
    "env": [
      "[A-Z_]+_APP_(?:ID|KEY|INSTALLATION_ID)"
    ],
    "hosts": [
      "api.github.com"
    ]
  },
  "settings": {
    "type": "object",
    "required": [
      "app_id",
      "private_key",
      "installation_id"
    ],
    "additionalProperties": false,
    "properties": {
      "app_id": {
        "type": "string"
      },
      "private_key": {
        "type": "string",
        "description": "The app's PEM key, from the project's Bitwarden project"
      },
      "installation_id": {
        "type": "string"
      }
    }
  }
}
