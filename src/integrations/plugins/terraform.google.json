{
  "id": "terraform.google",
  "provider": "Google",
  "use": "Google Cloud resources, through Terraform",
  "operations": [
    {
      "name": "apply",
      "class": "E",
      "route": "reported"
    }
  ],
  "setup": [
    "Create a token for the provider and store it in the project's Bitwarden project"
  ],
  "detect": {
    "terraform_providers": [
      "hashicorp/google",
      "hashicorp/google-beta"
    ]
  }
}
