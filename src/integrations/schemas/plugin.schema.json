{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sustenaut/integrations/blob/main/src/integrations/schemas/plugin.schema.json",
  "title": "An integration plugin: one way we use one provider",
  "type": "object",
  "required": ["id", "provider", "use", "operations", "setup", "detect"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$", "description": "provider.use; also the file's name"},
    "provider": {"type": "string", "minLength": 1},
    "use": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "class", "route"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "class": {"enum": ["H", "E", "S", "M"], "description": "classes.json gives its targets"},
          "route": {"enum": ["routed", "reported", "none"], "description": "routed: through the service; reported: a vendor's own action makes the call and a record is posted; none: nothing to log"},
          "timeout": {"type": "number", "exclusiveMinimum": 0, "description": "Seconds, in place of its class's, for an operation the class doesn't fit"},
          "tries": {"type": "integer", "minimum": 1, "description": "In place of its class's"}
        }
      }
    },
    "settings": {"type": "object", "description": "A JSON schema for what a repository gives the plugin's client"},
    "setup": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "The manual steps, in order"},
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {"$ref": "#/$defs/strings", "description": "Host names; *.name means any name under it"},
        "env": {"$ref": "#/$defs/strings", "description": "Regexes for whole environment or secret names"},
        "commands": {"$ref": "#/$defs/strings", "description": "Command names, found on shell lines and as argv[0]"},
        "actions": {"$ref": "#/$defs/strings", "description": "Prefixes of a GitHub Action's uses: value"},
        "terraform_providers": {"$ref": "#/$defs/strings", "description": "Provider sources, as namespace/name"},
        "files": {"$ref": "#/$defs/strings", "description": "Path patterns whose presence is a use"},
        "patterns": {"$ref": "#/$defs/strings", "description": "Other regexes, for a line of code or config"}
      }
    },
    "record": {"$ref": "#/$defs/record", "description": "How the plugin's calls are recorded and replayed: integrations.transports"}
  },
  "if": {"properties": {"detect": {"maxProperties": 0}}},
  "then": {"properties": {"operations": {"items": {"properties": {"class": {"const": "M"}}}}}},
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "headers": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"}},
    "paths": {"type": "array", "items": {"type": "string", "pattern": "^\\$(\\.\\.?([A-Za-z0-9_-]+|\\*)|\\[\\*\\])+$"}, "description": "JSONPath-lite: $.a.b, $..key, $.a[*].b, $.a.*"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {"type": "string", "pattern": "^_[a-z0-9-]+$", "description": "A shared record-only file, plugins/<name>.json, merged under these rules: lists joined, objects merged, the rest replaced"},
        "keep_headers": {"$ref": "#/$defs/headers", "description": "The headers a recording keeps, of requests and answers; every other is dropped"},
        "volatile": {
          "type": "object",
          "additionalProperties": false,
          "description": "What changes between two recordings of the same calls: written as placeholders, given stand-ins on replay",
          "properties": {
            "headers": {"$ref": "#/$defs/headers"},
            "json": {"$ref": "#/$defs/paths"},
            "values": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"}, "additionalProperties": {"type": "string", "minLength": 1}, "description": "A regex per kind, for a value anywhere: a body, a URL, a header"}
          }
        },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "description": "What a recording never writes: headers dropped, JSON paths and query parameters replaced",
          "properties": {
            "headers": {"$ref": "#/$defs/headers"},
            "json": {"$ref": "#/$defs/paths"},
            "query": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "description": "How a request finds its recorded call",
          "properties": {
            "url": {"const": "scheme+host+path+sorted-query"},
            "body": {"enum": ["json", "text"]},
            "graphql": {"enum": ["query-name+variables", null]}
          }
        },
        "customers": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$", "description": "The set of test customers recordings are made with, such as github.test"}
      }
    },
    "shared": {
      "type": "object",
      "description": "A shared record-only file, plugins/_name.json: not a plugin, only the rules plugins extend",
      "required": ["description", "record"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "record": {"$ref": "#/$defs/record"}
      }
    }
  }
}
