{
  "kind": "utility",
  "bin": "integrations",
  "ci": {
    "language": "python",
    "release": {}
  },
  "protect": {
    "checks": [
      "ci / passed",
      "release / release",
      "integrations / scan",
      "clients"
    ],
    "release_app": 5529889
  },
  "variables": {
    "names": ["INGEST_DATASETS", "INGEST_SIGNALS", "INGEST_NEED_STATES", "INGEST_PUBKIT_CHECKS", "INGEST_BUFFERS", "INTEGRATIONS_ORIGINS", "INTEGRATIONS_EDIT_PR_REPOS"],
    "deploy": "deploy.yml"
  },
  "signing_keys": [
    {"path": "corpus/.publet/signing.key", "bitwarden": {"project": {"id": "377de170-5487-40f7-9a01-b4f50064e1c5", "name": "Pub"}, "name": "pub-signing-key-integrations"}}
  ],
  "deploy": {
    "providers": [{"distribution": "pubdeploy", "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.4.1/pubdeploy-0.4.1-py3-none-any.whl", "sha256": "c9c9b49b44b771c6f15219c186e3646203381c6a30570c0b2568951d3a53deb0"}, {"distribution": "pubsec", "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.2.3/pubsec-0.2.3-py3-none-any.whl", "sha256": "4a0b9435ff111565265f330fa3a1642b59562d77b5d1806c1bfecfe83e63b106"}],
    "namespace": "integrations",
    "host": "integrations.sustenaut.eu",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_INTEGRATIONS",
    "needs": [
      {
        "type": "gcp.workload-identity",
        "account": "integrations-ingest",
        "project": "sustenaut",
        "serviceaccount": "ingest",
        "pool": "projects/948171295184/locations/global/workloadIdentityPools/services",
        "granted_in": "Sustenaut/shared-infra's infra/services-identity.tf"
      },
      {
        "type": "k8s.manifests",
        "path": "k8s/admin/network-policy.yaml"
      },
      {
        "type": "upstream",
        "name": "storage",
        "health": "https://storage.sustenaut.eu/"
      },
      {
        "type": "storage.tenant",
        "name": "calls-integrations",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:integrations/ingest"
        ],
        "write": [
          "k8s:integrations/app",
          "k8s:integrations/ingest"
        ],
        "delete": [
          "k8s:integrations/ingest"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-id",
        "secret": {"name": "ci-jobs-app", "key": "app-id"}
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-key",
        "secret": {"name": "ci-jobs-app", "key": "app-key"}
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-installation-id",
        "secret": {"name": "ci-jobs-app", "key": "installation-id"}
      },
      {
        "type": "storage.tenant",
        "name": "ci-usage",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": ["k8s:integrations/ingest"],
        "write": ["k8s:integrations/ci-jobs", "k8s:integrations/ingest"],
        "delete": ["k8s:integrations/ingest"],
        "private": true,
        "inbox": true
      },
      {
        "type": "storage.tenant",
        "name": "ci-jobs",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": ["k8s:integrations/ci-jobs"],
        "write": ["k8s:integrations/ci-jobs"],
        "private": true,
        "heads": true
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
