{
  "kind": "utility",
  "bin": "integrations",
  "ci": {
    "language": "python",
    "release": {}
  },
  "protect": {
    "checks": [
      "ci / passed",
      "release / release",
      "integrations / scan",
      "clients"
    ],
    "release_app": 5529889
  },
  "variables": {
    "names": [
      "INGEST_DATASETS",
      "INGEST_SIGNALS",
      "INGEST_NEED_STATES",
      "INGEST_PUBRULES_CHECKS",
      "INGEST_BUFFERS",
      "INGEST_SWEEP_SECONDS",
      "INGEST_REPORT_SECONDS",
      "INGEST_BATCH_GAP_SECONDS",
      "INTEGRATIONS_ORIGINS",
      "INTEGRATIONS_EDIT_PR_REPOS"
    ],
    "deploy": "deploy.yml"
  },
  "signing_keys": [
    {
      "path": "corpus/.publet/signing.key",
      "bitwarden": {
        "project": {
          "id": "377de170-5487-40f7-9a01-b4f50064e1c5",
          "name": "Pub"
        },
        "name": "pub-signing-key-integrations"
      }
    }
  ],
  "deploy": {
    "providers": [
      {
        "distribution": "pubdeploy",
        "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.5.2/pubdeploy-0.5.2-py3-none-any.whl",
        "sha256": "d783284288181f025e11d64505c1a28cf52ba24231d5309e03d1073914cfa457"
      },
      {
        "distribution": "pubsec",
        "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.3.0/pubsec-0.3.0-py3-none-any.whl",
        "sha256": "a9036c741e29098cdd04baf64c7873e0ff1dd6e7bde12e9671a3940370724e18"
      }
    ],
    "namespace": "integrations",
    "host": "integrations.sustenaut.eu",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_INTEGRATIONS",
    "needs": [
      {
        "type": "gcp.workload-identity",
        "account": "integrations-ingest",
        "project": "sustenaut",
        "serviceaccount": "ingest",
        "pool": "projects/948171295184/locations/global/workloadIdentityPools/services",
        "granted_in": "Sustenaut/shared-infra's infra/services-identity.tf"
      },
      {
        "type": "k8s.manifests",
        "path": "k8s/admin/network-policy.yaml"
      },
      {
        "type": "upstream",
        "name": "storage",
        "health": "https://storage.sustenaut.eu/"
      },
      {
        "type": "storage.tenant",
        "name": "calls-integrations",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:integrations/ingest"
        ],
        "write": [
          "k8s:integrations/app",
          "k8s:integrations/ingest"
        ],
        "delete": [
          "k8s:integrations/ingest"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-id",
        "secret": {
          "name": "ci-jobs-app",
          "key": "app-id"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-key",
        "secret": {
          "name": "ci-jobs-app",
          "key": "app-key"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-installation-id",
        "secret": {
          "name": "ci-jobs-app",
          "key": "installation-id"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "ingest-notify-key",
        "secret": {
          "name": "ingest-notify",
          "key": "key"
        }
      },
      {
        "type": "storage.tenant",
        "name": "ci-usage",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:integrations/ingest"
        ],
        "write": [
          "k8s:integrations/ci-jobs",
          "k8s:integrations/ingest"
        ],
        "delete": [
          "k8s:integrations/ingest"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "storage.tenant",
        "name": "ci-jobs",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:integrations/ci-jobs"
        ],
        "write": [
          "k8s:integrations/ci-jobs"
        ],
        "private": true,
        "heads": true
      },
      {
        "type": "k8s.job-once",
        "name": "ci-jobs-backfill",
        "cronjob": "ci-jobs",
        "args": [
          "--since-days",
          "90"
        ],
        "timeout": "6h",
        "rerun": "never",
        "after": [
          "k8s.secret:ci-jobs-app",
          "storage.tenant:ci-usage",
          "storage.tenant:ci-jobs"
        ]
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
