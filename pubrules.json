{
  "kind": "utility",
  "bin": "integrations",
  "ci": {
    "language": "python",
    "release": {}
  },
  "protect": {
    "checks": [
      "ci / passed",
      "release / release",
      "integrations / scan",
      "clients"
    ],
    "release_app": 5529889
  },
  "variables": {
    "version": 2,
    "names": [
      "INGEST_DATASETS",
      "INGEST_SIGNALS",
      "INGEST_NEED_STATES",
      "INGEST_PUBRULES_CHECKS",
      "INGEST_BUFFERS",
      "INGEST_SWEEP_SECONDS",
      "INGEST_REPORT_SECONDS",
      "INGEST_BATCH_GAP_SECONDS",
      "INTEGRATIONS_ORIGINS",
      "INTEGRATIONS_EDIT_PR_REPOS"
    ],
    "defaults": {
      "INGEST_SWEEP_SECONDS": "120",
      "INGEST_REPORT_SECONDS": "120",
      "INGEST_BATCH_GAP_SECONDS": "120"
    },
    "deploy": "deploy.yml"
  },
  "signing_keys": [
    {
      "path": "corpus/.publet/signing.key",
      "bitwarden": {
        "project": {
          "id": "377de170-5487-40f7-9a01-b4f50064e1c5",
          "name": "Pub"
        },
        "name": "pub-signing-key-integrations"
      }
    }
  ],
  "github_app": {
    "id": {
      "from": "github-test-recorder-app-id",
      "to": "TEST_RECORDER_APP_ID"
    },
    "installation_id": {
      "from": "github-test-recorder-installation-id",
      "to": "TEST_RECORDER_APP_INSTALLATION_ID"
    },
    "key": {
      "from": "github-test-recorder-app-key",
      "to": "TEST_RECORDER_APP_KEY"
    }
  },
  "deploy": {
    "providers": [
      {
        "distribution": "pubdeploy",
        "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.8.1/pubdeploy-0.8.1-py3-none-any.whl",
        "sha256": "b51b7551a0da6cc9165e3429f443a0a3b9a2a311871f759fb27d11d68501aed2"
      },
      {
        "distribution": "pubsec",
        "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.4.0/pubsec-0.4.0-py3-none-any.whl",
        "sha256": "b6e493d2b05c10ce0524a5e97397bd2a459a9ac67f6059eea7646457698bed45"
      }
    ],
    "namespace": "integrations",
    "host": "integrations.sustenaut.eu",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_INTEGRATIONS",
    "needs": [
      {
        "type": "gcp.workload-identity",
        "account": "integrations-ingest",
        "project": "sustenaut",
        "serviceaccount": "ingest",
        "pool": "projects/948171295184/locations/global/workloadIdentityPools/services",
        "granted_in": "Sustenaut/shared-infra's infra/services-identity.tf"
      },
      {
        "type": "k8s.manifests",
        "path": "k8s/admin/network-policy.yaml"
      },
      {
        "type": "upstream",
        "name": "storage",
        "health": "https://storage.sustenaut.eu/"
      },
      {
        "type": "storage.tenant",
        "name": "calls-integrations",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:integrations/ingest"
        ],
        "write": [
          "k8s:integrations/app",
          "k8s:integrations/ingest"
        ],
        "delete": [
          "k8s:integrations/ingest"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-id",
        "secret": {
          "name": "ci-jobs-app",
          "key": "app-id"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-key",
        "secret": {
          "name": "ci-jobs-app",
          "key": "app-key"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-installation-id",
        "secret": {
          "name": "ci-jobs-app",
          "key": "installation-id"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "ingest-notify-key",
        "secret": {
          "name": "ingest-notify",
          "key": "key"
        }
      },
      {
        "type": "storage.tenant",
        "name": "ci-usage",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:integrations/ingest"
        ],
        "write": [
          "k8s:integrations/ci-jobs",
          "k8s:integrations/ingest"
        ],
        "delete": [
          "k8s:integrations/ingest"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "storage.tenant",
        "name": "ci-jobs",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:integrations/ci-jobs"
        ],
        "write": [
          "k8s:integrations/ci-jobs"
        ],
        "private": true,
        "heads": true
      },
      {
        "type": "k8s.job-once",
        "name": "ci-jobs-backfill",
        "cronjob": "ci-jobs",
        "args": [
          "--since-days",
          "90"
        ],
        "timeout": "6h",
        "rerun": "never",
        "after": [
          "k8s.secret:ci-jobs-app",
          "storage.tenant:ci-usage",
          "storage.tenant:ci-jobs"
        ]
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
