#!/usr/bin/env bash
# Managed by pubrules 0.49.1: `pubrules sync` rewrites this file, and
# `pubrules sync --check` fails when it differs.
#
# Run this repository's pinned pubsec, which holds what pubrules does not: a
# secret's value, a write token, a private key. ./with-secrets runs it, and
# the deploy walk loads its need types.
#
#   ./pubsec run -- terraform plan
#   ./pubsec --version
#
# The release is deploy.providers' pubsec, or where it lists none the one
# this file fetched when sync first wrote it; the nightly moves it.
# Its wheel is fetched once into the user's cache (from the wheel mirror,
# when pubrules.json names one and GitHub fails) and checked against its
# sha256 on every run, and uvx runs that file; nothing is installed into the
# repository or the system. pubsec runs in the repository's root, where
# with-secrets.json is, from whichever directory this is called.
set -euo pipefail

if ! command -v uvx >/dev/null 2>&1; then
  echo "pubsec: ./pubsec runs pubsec with uv, which is not installed: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 127
fi

cd "$(dirname "$0")"
# A wheel, fetched once into the user's cache, checked against its sha256 on every run.
fetch() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/pubrules/$3/$2" sum
  fetched="$dir/${1##*/}"
  if [ ! -f "$fetched" ]; then
    mkdir -p "$dir"
    curl -fsSL -o "$fetched.part" "$1" \
      || curl -fsSL -o "$fetched.part" "https://storage.sustenaut.eu/wheels/f/$2/${1##*/}" \
      || { rm -f "$fetched.part"; echo "pubrules: could not fetch $1" >&2; exit 1; }
    mv "$fetched.part" "$fetched"
  fi
  if command -v sha256sum >/dev/null 2>&1; then sum=$(sha256sum "$fetched"); else sum=$(shasum -a 256 "$fetched"); fi
  if [ "${sum%% *}" != "$2" ]; then
    rm -f "$fetched"
    echo "pubrules: $1 is not the wheel $4 pins (sha256 $2)" >&2
    exit 1
  fi
}

fetch https://github.com/Sustenaut/pubsec/releases/download/v0.4.1/pubsec-0.4.1-py3-none-any.whl 49aca88917f2856dcefce4be89826e95dc5c9cb17f0f0a2fdafecba6cc13de53 providers deploy.providers
exec uvx --from "$fetched" pubsec "$@"
