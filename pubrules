#!/usr/bin/env bash
# Managed by pubrules 0.45.0: `pubrules sync` rewrites this file, and
# `pubrules sync --check` fails when it differs.
#
# Run this repository's pubrules: the version its managed files and
# tests/requirements.lock pin, whichever pubrules is installed, if any.
#
#   ./pubrules sync --check
#
# uvx fetches that release's wheel once and keeps it in uv's cache; nothing
# is installed into the repository or the system. pubrules runs in the
# repository's root, where pubrules.json is, from whichever directory this is
# called.
#
# With a wheel mirror in pubrules.json (mirror.wheels), the wheel is fetched
# here instead, checked against the sha256 tests/requirements.lock pins, and
# taken from the mirror when GitHub's release download fails.
set -euo pipefail

if ! command -v uvx >/dev/null 2>&1; then
  echo "pubrules: ./pubrules runs pubrules 0.45.0 with uv, which is not installed: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 127
fi

cd "$(dirname "$0")"
# A wheel, fetched once into the user's cache, checked against its sha256 on every run.
fetch() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/pubrules/$3/$2" sum
  fetched="$dir/${1##*/}"
  if [ ! -f "$fetched" ]; then
    mkdir -p "$dir"
    curl -fsSL -o "$fetched.part" "$1" \
      || curl -fsSL -o "$fetched.part" "https://storage.sustenaut.eu/wheels/f/$2/${1##*/}" \
      || { rm -f "$fetched.part"; echo "pubrules: could not fetch $1" >&2; exit 1; }
    mv "$fetched.part" "$fetched"
  fi
  if command -v sha256sum >/dev/null 2>&1; then sum=$(sha256sum "$fetched"); else sum=$(shasum -a 256 "$fetched"); fi
  if [ "${sum%% *}" != "$2" ]; then
    rm -f "$fetched"
    echo "pubrules: $1 is not the wheel $4 pins (sha256 $2)" >&2
    exit 1
  fi
}

# The packages pubrules.json's deploy.providers names, each wheel checked against its sha256.
with=()
provider() {
  fetch "$1" "$2" providers deploy.providers
  with+=(--with "$fetched")
}
provider https://github.com/Sustenaut/pubdeploy/releases/download/v0.5.0/pubdeploy-0.5.0-py3-none-any.whl 320d68e081c674457294e6ed3a6c8ab9e2606ca4a2946c252a34021b62dc70cd
provider https://github.com/Sustenaut/pubsec/releases/download/v0.3.0/pubsec-0.3.0-py3-none-any.whl a9036c741e29098cdd04baf64c7873e0ff1dd6e7bde12e9671a3940370724e18

# pubrules' own wheel, by the sha256 tests/requirements.lock pins, from the mirror when GitHub fails.
from="https://github.com/Sustenaut/pubrules/releases/download/v0.45.0/pubrules-0.45.0-py3-none-any.whl"
pin=$(sed -n "\#^pubrules @ $from#,/--hash=sha256:/s/.*--hash=sha256:\([0-9a-f]\{64\}\).*/\1/p" tests/requirements.lock 2>/dev/null | head -n 1)
if [ -n "$pin" ]; then
  fetch "$from" "$pin" wheels tests/requirements.lock
  from="$fetched"
fi
exec uvx --from "$from" "${with[@]}" pubrules "$@"
